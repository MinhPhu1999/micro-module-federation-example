{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "auth/*": [
        "../auth/dist/@mf-types/*",
        "./@mf-types/auth/*"
      ],
      "todo/*": [
        "../todo/dist/@mf-types/*",
        "./@mf-types/todo/*"
      ],
      "navbar/*": [
        "../navbar/dist/@mf-types/*",
        "./@mf-types/navbar/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
